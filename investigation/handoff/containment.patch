+def extract(names):
+    ns = dict(datetime=datetime, timedelta=timedelta, timezone=timezone,
+              logger=logging.getLogger('offline-tests'), random=random,
+              os=os, uuid=uuid, PLACEHOLDER_QTY_VALUES=PLACEHOLDER_QTY_VALUES,
+              MAX_QTY_DELTA_PER_INTERVAL=MAX_QTY_DELTA_PER_INTERVAL,
+              MAX_DAILY_SALES_PER_SKU=MAX_DAILY_SALES_PER_SKU,
+              MAX_SOLD_COUNT_DELTA_PER_INTERVAL=MAX_SOLD_COUNT_DELTA_PER_INTERVAL,
+              MIN_AGGREGATION_CONFIDENCE=MIN_AGGREGATION_CONFIDENCE)
+    nodes = []
+    for n in ast.parse((BACKEND/'server.py').read_text(encoding='utf-8')).body:
+        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name in names:
+            n.decorator_list = []
+            nodes.append(n)
+        elif isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id in names for t in n.targets):
+            nodes.append(n)
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), 'server.py', 'exec'), ns)
+    return ns
+
+def matches(row, q):
+    for k, v in q.items():
+        value = row.get(k)
+        if isinstance(v, dict):
+            for op, bound in v.items():
+                if op == '$gte' and not (value is not None and value >= bound): return False
+                if op == '$lt' and not (value is not None and value < bound): return False
+        elif value != v:
+            return False
+    return True
+
+class Cursor:
+    def __init__(self, rows): self.rows = rows
+    def batch_size(self, _): return self
+    def __aiter__(self): self.it = iter(self.rows); return self
+    async def __anext__(self):
+        try: return next(self.it)
+        except StopIteration: raise StopAsyncIteration
+    async def to_list(self, n=None): return self.rows[:n]
+
+class Collection:
+    def __init__(self): self.rows = []
+    def find(self, q=None, projection=None): return Cursor([r for r in self.rows if matches(r, q or {})])
+    async def count_documents(self, q): return sum(matches(r, q) for r in self.rows)
+    async def insert_one(self, r): self.rows.append(copy.deepcopy(r))
+    async def insert_many(self, rows): self.rows.extend(copy.deepcopy(rows))
+    async def delete_many(self, q): self.rows = [r for r in self.rows if not matches(r, q)]
+    async def create_index(self, *a, **kw): pass
+
+class DB:
+    def __init__(self): self.cols = {}
+    def __getattr__(self, k): return self.cols.setdefault(k, Collection())
+
+def snap(qty, sold=None, day=1, **extra):
+    return dict(sku='SKU', store_id='store', qty_available=qty, sold_count=sold,
+                price=10, confidence_score=99, source_tier=1, in_stock=True,
+                crawled_at=datetime(2026,10,day,6,tzinfo=timezone.utc), **extra)
+
+class SignalTests(unittest.TestCase):
+    def test_missing_quantity_is_not_depletion(self):
+        self.assertEqual(estimate([snap(20), snap(None)], 30)[:2], (0, 0.0))
+    def test_missing_counter_is_not_a_reset_to_zero(self):
+        self.assertEqual(estimate([snap(10,100),snap(10,None),snap(10,100)],30)[:2], (0,0.0))
+    def test_missing_stock_breaks_interval(self):
+        self.assertEqual(estimate([snap(8),snap(None),snap(3)],30)[0],0)
+    def test_placeholder_breaks_interval(self):
+        self.assertEqual(estimate([snap(8),snap(999),snap(3)],30)[0],0)
+    def test_real_zero_quantity_is_usable(self):
+        self.assertEqual(estimate([snap(8),snap(0)],30)[:2],(8,80.0))
+    def test_usable_stock_drop_is_preserved(self):
+        self.assertEqual(estimate([snap(8),snap(3)],30)[:2],(5,50.0))
+    def test_large_stock_drop_is_withheld_not_capped(self):
+        self.assertEqual(estimate([snap(40),snap(0)],30)[0],0)
+    def test_counter_gap_is_withheld_not_capped(self):
+        self.assertEqual(estimate([snap(None,100),snap(None,900)],30)[0],0)
+    def test_counter_change_is_preserved(self):
+        self.assertEqual(estimate([snap(None,100),snap(None,105)],30)[:2],(5,50.0))
+    def test_flat_observed_counter_does_not_switch_methods(self):
+        self.assertEqual(estimate([snap(20,100),snap(10,100)],30), (0,0.0,'sold_count_diff'))
+    def test_nan_is_not_an_observation(self):
+        self.assertEqual(estimate([snap(8),snap(float('nan'))],30)[0],0)
+    def test_capped_counter_not_used(self):
+        self.assertEqual(estimate([snap(None,100),snap(None,120,sold_count_capped=True)],30)[0],0)
+
+class ServerTests(unittest.TestCase):
+    def seed(self, env):
+        ns=extract({'seed_database','STORES_SEED','PRODUCTS_SEED','EXTRA_PRODUCT_TEMPLATES'})
+        db=DB(); ns['db']=db
+        with patch.dict(os.environ, env, clear=True): asyncio.run(ns['seed_database']())
+        return db
+    def test_seed_off_by_default(self):
+        self.assertEqual(self.seed({}).product_snapshots.rows, [])
+    def test_seed_cannot_opt_in_in_production(self):
+        self.assertEqual(self.seed({'SEED_DEMO_DATA':'true','APP_ENV':'production'}).product_snapshots.rows,[])
+    def test_explicit_development_seed_marked_synthetic(self):
+        rows=self.seed({'SEED_DEMO_DATA':'true','APP_ENV':'development'}).product_snapshots.rows
+        self.assertGreater(len(rows), 0)
+        self.assertTrue(all(r.get('is_synthetic') and r.get('data_origin')=='demo_seed' for r in rows))
+    def rollup(self, rows):
+        ns=extract({'_recompute_store_metrics','_metric_day_str'})
+        db=DB(); db.product_snapshots.rows=rows
+        asyncio.run(ns['_recompute_store_metrics'](db,'store'))
+        return db.sku_sales_daily.rows
+    def test_daily_rollup_missing_stock_not_sales(self):
+        self.assertEqual(self.rollup([snap(20, day=1),snap(None,day=2)]),[])
+    def test_daily_rollup_missing_counter_not_sales(self):
+        self.assertEqual(self.rollup([snap(None,100,1),snap(None,None,2),snap(None,100,3)]),[])
+    def test_daily_rollup_does_not_bridge_missing_stock(self):
+        self.assertEqual(self.rollup([snap(8,day=1),snap(None,day=2),snap(3,day=3)]),[])
+    def test_daily_rollup_real_depletion_preserved(self):
+        rows=self.rollup([snap(8,day=1),snap(3,day=2)])
+        self.assertEqual(sum(r['units_qty'] for r in rows),5)
+    def test_proxy_revenue_not_exact(self):
+        f=extract({'_ranking_revenue_value'})['_ranking_revenue_value']
+        self.assertEqual(f({'revenue_30d':200}), (200.0,'estimated'))
+        self.assertEqual(f({'revenue_30d':200,'revenue_basis':'orders_exact'}), (200.0,'exact'))
+    def test_legacy_share_withheld_instead_of_200_percent(self):
+        tree=ast.parse((BACKEND/'server.py').read_text(encoding='utf-8'))
+        fn=next(n for n in tree.body if isinstance(n,ast.AsyncFunctionDef) and n.name=='_my_products_dataset')
+        block=next(n for n in fn.body if isinstance(n,ast.For) and isinstance(n.target,ast.Name) and n.target.id=='r')
+        ns={'result':[dict(qty_sold_est=10,my_units_sold=20,num_priced_competitors=1)]}
+        exec(compile(ast.Module(body=[block],type_ignores=[]),'server.py','exec'),ns)
+        self.assertIsNone(ns['result'][0]['market_share_pct'])
+        self.assertFalse(ns['result'][0]['has_market_share'])
