# Copy to backend/.env and fill in. All five are required.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=daleel_pets
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
CORS_ORIGINS=*

# Set false on real deployments — the demo seed writes synthetic products and
# price snapshots that pollute live crawl analytics. Stores themselves are
# always seeded from store_registry.py.
SEED_DEMO_DATA=false

# Optional: Zid Merchant API for the own store (pets-houses.com). When set,
# own-store sync uses the authenticated API instead of the public crawl.
#ZID_API_TOKEN=
#ZID_STORE_ID=

# Optional: Saudi residential proxy (Webshare) for stores flagged use_proxy.
#PROXY_HOST=
#PROXY_PORT=
#PROXY_USER=
#PROXY_PASS=
