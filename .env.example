# ============================================================================
# Svaneti with Georgie — environment configuration
# Copy to `.env` and fill values. NEVER commit a real .env.
# Production startup validates required vars and refuses insecure defaults.
# ============================================================================

# --- Application environment ------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=info

# --- URLs -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173  # used for CORS + canonical links
BACKEND_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:5173

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=svaneti

# --- Authentication secrets (REQUIRED in production) ------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
ARGON2_TIME_COST=3
ARGON2_MEMORY_KB=65536
ARGON2_PARALLELISM=2

# --- Cookies ----------------------------------------------------------------
COOKIE_DOMAIN=                      # blank = host-only
COOKIE_SECURE=false                 # MUST be true in production (HTTPS)
COOKIE_SAMESITE=lax                 # lax | strict | none
CSRF_SECRET=change-me-csrf-secret

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Media provider ---------------------------------------------------------
MEDIA_PROVIDER=local                # local | cloudinary | s3
MEDIA_LOCAL_DIR=./backend/media_store
MEDIA_PUBLIC_BASE=/media            # URL prefix the API serves local files from
MEDIA_MAX_MB=25
MEDIA_ALLOWED_IMAGE=image/jpeg,image/png,image/webp,image/avif
MEDIA_ALLOWED_VIDEO=video/mp4,video/webm

# Cloudinary (when MEDIA_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3 / compatible (when MEDIA_PROVIDER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# --- Email / SMTP (OPTIONAL — app works without it) -------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
INQUIRY_NOTIFY_TO=                  # owner address for new-inquiry alerts

# --- Analytics (OPTIONAL, consent-gated on the frontend) --------------------
GA_MEASUREMENT_ID=
GSC_VERIFICATION=
META_PIXEL_ID=

# --- Map --------------------------------------------------------------------
MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Admin bootstrap (used by scripts/create_admin) -------------------------
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=ChangeMe!Now123
FORCE_PASSWORD_CHANGE=true

# --- Feature flags ----------------------------------------------------------
FEATURE_PAYMENTS=false              # keep OFF in v1
SEED_SAMPLE_REVIEWS=true            # forced false when APP_ENV=production

# --- SEO / SSR shell --------------------------------------------------------
# When true, FastAPI serves the built SPA and injects route-specific SEO meta
# (title/description/canonical/OG/JSON-LD) server-side. Keep false for the Vite
# dev server; set true (with a built frontend) to serve everything from one app.
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=./frontend/dist

# --- Dev-only helpers (NEVER true in production) ----------------------------
# USE_MOCK_DB runs an in-process store so the API works without MongoDB (dev/e2e).
USE_MOCK_DB=false
SEED_ON_STARTUP=false               # seed + dev-owner bootstrap on startup (dev only)

# --- Emergent deployment notes ----------------------------------------------
# On Emergent, set MONGODB_URI to the managed connection string, COOKIE_SECURE=true,
# APP_ENV=production, a strong JWT_SECRET/CSRF_SECRET, and a production MEDIA_PROVIDER.
# See docs/EMERGENT_HANDOFF.md.

# --- Frontend (Vite) build-time vars (mirror into frontend/.env) ------------
VITE_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
